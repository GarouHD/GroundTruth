# Copy to .env and fill in.  .env is gitignored; this file is not.

# --- Postgres (used by docker-compose and the app) ---
POSTGRES_USER=groundtruth
POSTGRES_PASSWORD=changeme
POSTGRES_DB=groundtruth
POSTGRES_HOST=db
POSTGRES_PORT=5432

# DATABASE_URL is what the app actually reads. Host is the compose service
# name ("db") from inside a container, "localhost" from your shell.
DATABASE_URL=postgresql://groundtruth:changeme@db:5432/groundtruth

# --- Provider keys ---
# Left blank until the transcription / embedding / generation providers are
# decided. Fill in only the ones the chosen stack actually uses.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
